# 对话桥设置：复制一份改名为 config.env 再填。⚠️ config.env 里有密钥，不要发给别人（已在 .gitignore 里）

# 和 firmware/config.h、cloud 里一样的板子密钥
BOARD_TOKEN=

# 怎么称呼你（给 Claude 看的）
USER_NAME=小明

# 叫它的名字，逗号分隔。把 whisper 常听错的写法也加进来（看 bridge.log 里 heard 后面识别成了什么）
# 公共名字：只出字幕、不出声，回答简短得体（在公开场合 / 有别人在）
NAMES_PUBLIC=Momo,摸摸,模模
# 私人名字：放松聊天，可以开口说话
NAMES_PRIVATE=小摸,小莫

# 人设：这个文件夹里的 CLAUDE.md 就是它的性格和你们的相处方式（照 persona/CLAUDE.example.md 写）
PERSONA_DIR=./persona

# Claude Code 的模型（sonnet 回得快，适合语音）
CLAUDE_MODEL=sonnet

# 可选：开口说话（ElevenLabs）
ELEVENLABS_API_KEY=
VOICE_ID=
VOICE_SPEED=1.0
VOICE_LANG=中文

# 可选："记一下……"写到哪个文件夹（比如 Obsidian 的收集箱）
NOTES_DIR=

# 可选：给它接 MCP（比如记忆服务）。MCP_CONFIG 是 .mcp.json 的路径，MCP_ALLOWED 是允许用的工具（逗号分隔）
MCP_CONFIG=
MCP_ALLOWED=

# 声纹门槛（录了声纹才有用），看日志里的 score 再调
VOICE_THRESHOLD=0.50
